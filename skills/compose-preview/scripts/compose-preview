#!/usr/bin/env bash
#
# Bootstrap stub for `compose-preview`.
#
# Plugin and `npx skills add` installs ship the skill markdown but not the CLI
# (a JVM app released from yschimke/compose-ai-tools). On first use this stub
# runs `install.sh --cli-only`, which installs the CLI and links
# ~/.local/bin/compose-preview, then re-execs into the real launcher with the
# original arguments. Later calls find the real CLI and exec it directly.

set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# A `compose-preview` that isn't this stub: known locations first, then PATH.
resolve_real_cli() {
  local candidate
  for candidate in \
      "$HOME/.local/bin/compose-preview" \
      "${COMPOSE_PREVIEW_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/compose-preview}/bin/compose-preview" \
      "$HOME/.agents/skills/compose-preview/bin/compose-preview"; do
    [[ -x "$candidate" ]] || continue
    [[ "$(readlink -f "$candidate")" == "$self" ]] && continue
    printf '%s\n' "$candidate"
    return 0
  done
  local IFS=:
  local path_dir
  for path_dir in $PATH; do
    [[ -x "$path_dir/compose-preview" ]] || continue
    [[ "$(readlink -f "$path_dir/compose-preview")" == "$self" ]] && continue
    printf '%s\n' "$path_dir/compose-preview"
    return 0
  done
  return 1
}

# Fast path: the real CLI is already installed somewhere, just exec it.
if real="$(resolve_real_cli)"; then
  exec "$real" "$@"
fi

# Cold path: prefer the installer from a skills checkout this stub lives in,
# else fetch it. The marker check stops the upward walk from running some
# unrelated scripts/install.sh (say, one in $HOME).
installer=""
search="$here"
while [[ "$search" != "/" ]]; do
  if [[ -f "$search/scripts/install.sh" ]] \
    && grep -q '^DEFAULT_COMPANION_SKILLS=(' "$search/scripts/install.sh"; then
    installer="$search/scripts/install.sh"
    break
  fi
  search="$(dirname "$search")"
done

echo "==> compose-preview CLI not found — bootstrapping (one-time)" >&2
if [[ -n "$installer" ]]; then
  bash "$installer" --cli-only
else
  curl -fsSL "https://raw.githubusercontent.com/yschimke/skills/main/scripts/install.sh" \
    | bash -s -- --cli-only
fi

if real="$(resolve_real_cli)"; then
  exec "$real" "$@"
fi

cat >&2 <<'EOF'
error: bootstrap finished but compose-preview is still not callable.
       check that ~/.local/bin/compose-preview exists and that
       ~/.local/bin is on your PATH (or set PREFIX= to choose another
       prefix when running scripts/install.sh).
EOF
exit 1
