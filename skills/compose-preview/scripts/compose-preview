#!/usr/bin/env bash
#
# Bootstrap stub for `compose-preview`.
#
# Lives inside the compose-preview skill bundle (yschimke/skills) and
# self-replaces — in effect — by running the canonical installer the
# first time it is invoked, then re-exec'ing into the real CLI.
#
# Why this file exists
# --------------------
# `/plugin install yschimke-skills@yschimke-skills` and
# `npx skills add yschimke/skills` install the skill markdown but do not
# download the CLI tarball. The CLI is a JVM app that lives in
# yschimke/compose-ai-tools releases. When an agent following SKILL.md
# tries to invoke `compose-preview` and there's nothing on PATH yet,
# either the agent reaches for this stub directly (its path is
# predictable inside the skill bundle), or the user has added the
# skill's `bin/` to PATH so this stub is found there.
#
# Either way, on the cold path the stub:
#   1. Runs the bundled `scripts/install.sh --cli-only`, which downloads
#      the CLI, lays it out under `~/.agents/skills/compose-preview/cli/`,
#      and symlinks `~/.local/bin/compose-preview` → the real launcher.
#      `--cli-only` keeps it from re-installing skill content (which the
#      plugin already put on disk under `~/.claude/plugins/...` or
#      `~/.claude/skills/...`).
#   2. Re-execs into that real launcher with the original argv.
#
# After the first run, future invocations of `compose-preview` hit the
# real launcher directly via PATH; this stub is only ever traversed on
# the cold path.

set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

resolve_real_cli() {
  # Find a `compose-preview` executable that isn't this stub. Known
  # absolute locations first (faster and ducks PATH-shadowing issues),
  # then a manual PATH walk that skips entries resolving back to us.
  local candidate
  for candidate in \
      "$HOME/.local/bin/compose-preview" \
      "$HOME/.agents/skills/compose-preview/bin/compose-preview"; do
    [[ -x "$candidate" ]] || continue
    [[ "$(readlink -f "$candidate")" == "$self" ]] && continue
    printf '%s\n' "$candidate"
    return 0
  done
  local IFS=:
  local path_dir
  for path_dir in $PATH; do
    [[ -x "$path_dir/compose-preview" ]] || continue
    [[ "$(readlink -f "$path_dir/compose-preview")" == "$self" ]] && continue
    printf '%s\n' "$path_dir/compose-preview"
    return 0
  done
  return 1
}

# Fast path: the real CLI is already installed somewhere, just exec it.
if real="$(resolve_real_cli)"; then
  exec "$real" "$@"
fi

# Cold path: bootstrap the CLI. Prefer the bundled installer (saves a
# network round-trip and works offline if the user has already cloned
# the skills repo); fall back to the canonical raw URL otherwise.
installer=""
search="$here"
while [[ "$search" != "/" ]]; do
  if [[ -x "$search/scripts/install.sh" ]]; then
    installer="$search/scripts/install.sh"
    break
  fi
  search="$(dirname "$search")"
done

echo "==> compose-preview CLI not found — bootstrapping (one-time)" >&2
if [[ -n "$installer" ]]; then
  bash "$installer" --cli-only
else
  curl -fsSL "https://raw.githubusercontent.com/yschimke/skills/main/scripts/install.sh" \
    | bash -s -- --cli-only
fi

# install.sh wrote ~/.local/bin/compose-preview → real launcher; re-exec.
if real="$(resolve_real_cli)"; then
  exec "$real" "$@"
fi

cat >&2 <<'EOF'
error: bootstrap finished but compose-preview is still not callable.
       check that ~/.local/bin/compose-preview exists and that
       ~/.local/bin is on your PATH (or set PREFIX= to choose another
       prefix when running scripts/install.sh).
EOF
exit 1
